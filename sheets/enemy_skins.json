{
 "sheet": "enemy_skins",
 "about": "One row = one Vermintide 2 enemy wearing one Dead Space 2 model. The mod hides the original model on each player's PC and links the skin to its skeleton, so the enemy keeps its own AI, animations, hit zones and networking.",
 "columns": {
  "id": "key",
  "source_model": "-> source_models.id",
  "breed": "Vermintide 2 breed name (Breeds.<name>)",
  "breed_source": "where breed/base_unit was read in the game's Lua (vt2src = github.com/Aussiemon/Vermintide-2-Source-Code (game Lua, read-only reference))",
  "host_base_unit": "the enemy's own unit (verified in source)",
  "faction": "chaos / skaven / beastmen",
  "why": "behaviour that makes the pairing work",
  "jank": "low / medium / high (expected look)",
  "skin_unit": "our unit, built with the Vermintide 2 SDK, packed in the mod bundle",
  "bones_file": "pipeline/bones/<breed>.txt: one bone name per line shared by the host skeleton and the skin (exported from the SDK on PC)",
  "scale": "uniform scale of the skin relative to the host",
  "hide_inventory": "also hide the enemy's weapons/outfit pieces",
  "gibs": "what dismemberment shows",
  "setting": "-> settings.id (toggle that enables this row)",
  "rigged": "true once the skin is weighted to the host skeleton and imported in the SDK",
  "tested_in_game": "true once seen working in a Modded Realm match"
 },
